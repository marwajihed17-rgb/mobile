# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for server-side admin operations)
# WARNING: Never expose this key on the client side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URL (for email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production URL (set this in Vercel environment variables)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
